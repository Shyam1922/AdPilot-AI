# LLM: auto = Gemini if key present, else offline deterministic generator
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=45

DATABASE_URL=sqlite:///./adpilot.db
STORAGE_DIR=./storage
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FETCH_TIMEOUT_S=10
DEMO_STORE_HOST=demo.adpilot.local

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Optional: path to a music track you have rights to
MUSIC_PATH=
SEED_DEMO=true
