# LLM: auto = Gemini if key present, else offline deterministic generator
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_S=20
# Newer Gemini models 'think' before answering; low keeps JSON tasks fast. Use 'default' to send nothing.
GEMINI_THINKING=low
# Tried in order if the main model is busy (503), rate-limited (429) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest

# Fallback providers (all optional, all OpenAI-compatible). Order of use is LLM_PROVIDERS; a provider is used only if it has a key.
# Free keys: Groq (console.groq.com), OpenRouter (openrouter.ai, ":free" models), Mistral (console.mistral.ai).
# Check each provider's page for current limits and model names; they change often.
LLM_PROVIDERS=gemini,groq,openrouter,mistral,cerebras,ollama,custom
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Local, no key, no internet: install Ollama, `ollama pull llama3.1:8b`, then set OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODEL=
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=

DATABASE_URL=sqlite:///./adpilot.db
STORAGE_DIR=./storage
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FETCH_TIMEOUT_S=10
DEMO_STORE_HOST=demo.adpilot.local

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Optional: path to a music track you have rights to
MUSIC_PATH=
# Meko (Yugabyte) agent memory: create a key at cloud.mekodata.ai -> Settings -> API Keys
MEKO_API_KEY=
MEKO_URL=https://mcp.mekodata.ai/mcp
# How the key is sent. Default: "Authorization: Bearer <key>". If Meko rejects it, try
# MEKO_AUTH_HEADER=x-api-key and MEKO_AUTH_SCHEME= (empty)
MEKO_AUTH_HEADER=Authorization
MEKO_AUTH_SCHEME=Bearer
# One datapack is created per brand (free plan allows 10). To force a single existing datapack for everything:
# MEKO_DATAPACK_ID=
MEKO_TIMEOUT_S=20
# X publishing (optional): app with "Read and write" permission, from developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
SEED_DEMO=true
